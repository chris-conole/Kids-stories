# ─────────────────────────────────────────────────────────────
# Dreamloom environment variables. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Dreamloom"

# Auth.js (NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Database (Postgres). For local dev you can use a Neon/Supabase/local URL.
DATABASE_URL="postgresql://user:password@localhost:5432/dreamloom?schema=public"

# ── Story engine (Anthropic / Claude) ──
ANTHROPIC_API_KEY="sk-ant-..."
# Model used for story generation. Long-form creative writing.
STORY_MODEL="claude-opus-4-8"

# ── Second-pass safety review ──
# Every story is independently reviewed before it can be delivered. Keep this
# ON in production. A cheap, fast model is ideal for the classifier.
SAFETY_CHECK="on"                          # on | off
SAFETY_MODEL="claude-haiku-4-5-20251001"
SAFETY_MAX_ATTEMPTS="2"                     # regenerate up to N times if blocked

# ── Email (Resend) — magic-link auth + nightly story delivery ──
RESEND_API_KEY="re_..."
EMAIL_FROM="Dreamloom <stories@yourdomain.com>"

# ── Stripe ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Price IDs created in the Stripe dashboard (see README).
STRIPE_PRICE_STANDARD="price_..."
STRIPE_PRICE_PLUS="price_..."

# ── Media storage (for Plus audio + illustrations) ──
# local: writes to public/generated (dev / single server).
# s3:    any S3-compatible bucket (AWS S3, Cloudflare R2…) — use this on Vercel.
STORAGE_PROVIDER="local"     # local | s3
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""               # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""             # public base URL for the bucket/CDN

# ── Text-to-speech narration (Plus tier) ──
# mock = silent clip so you can test the flow without keys.
TTS_PROVIDER="none"          # none | mock | openai | elevenlabs
TTS_API_KEY=""
TTS_VOICE="calm-female"      # OpenAI voice name, or an ElevenLabs voice ID
TTS_MODEL=""                 # optional override (e.g. gpt-4o-mini-tts / eleven_turbo_v2_5)

# ── Illustrations (Plus tier) ──
# mock = placeholder cards so you can test the flow without keys.
IMAGE_PROVIDER="none"        # none | mock | openai | replicate
IMAGE_API_KEY=""
IMAGE_MODEL=""               # optional override (e.g. gpt-image-1 / black-forest-labs/flux-schnell)
IMAGE_MAX="6"                # cap illustrations per story (cost control)

# ── Cron protection ──
# A shared secret so only your scheduler can trigger nightly generation.
CRON_SECRET="replace-me"

# How many minutes before a child's local bedtime to generate their story.
# The hourly, timezone-sharded cron uses this as the generation window.
GENERATION_LEAD_MINUTES="120"
